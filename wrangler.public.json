{
  "name": "kossori-tank",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCOREBOARD",
        "class_name": "Scoreboard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-scoreboard",
      "new_sqlite_classes": [
        "Scoreboard"
      ]
    }
  ]
}
