# Repository and local tooling are not public game assets.
**/.git
**/.github
**/node_modules
**/.wrangler
**/.DS_Store
**/.env
**/.env.*
/tests/
/docs/
/.assetsignore
/server/
/wrangler.json
# Preserve PNG masters in GitHub; deploy only the optimized WebP assets.
/assets/indoor/laboratory/*.png

# Jungle source masters are retained in Git, never served to the game.
/assets/jungle/*.png
/assets/jungle/*.jpeg
/assets/jungle/assets.json
